<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: tray icon, dashboard, settings window. Always runs with administrator rights (see app.manifest). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the tray icon (NotifyIcon) and the icons drawn for it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Udjat</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\udjat.ico</ApplicationIcon>
    <!-- The runtime's translations (13 folders, about 18 MB) are not needed: Udjat is in English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>Udjat</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both WPF and Windows Forms have a Button, a Color, a MessageBox... so neither is imported by default. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- The desktop SDK leaves these out of the default imports. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Udjat.Core\Udjat.Core.csproj" />
    <ProjectReference Include="..\Udjat.Windows\Udjat.Windows.csproj" />
    <ProjectReference Include="..\Udjat.Channels\Udjat.Channels.csproj" />
  </ItemGroup>

</Project>
