<UserControl x:Class="Udjat.Dashboard.OverviewPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Udjat.Dashboard">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PanelTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:PanelTemplateSelector x:Key="PanelSelector" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- One panel per part: processor, graphics card, memory, storage -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Panels}" ItemTemplateSelector="{StaticResource PanelSelector}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
