<Window x:Class="Udjat.Dashboard.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Udjat" Width="1080" Height="760" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.CommandBindings>
        <CommandBinding Command="NavigationCommands.GoToPage" Executed="OnGoToPage" />
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The side menu: the eye, the pages, then the theme switch -->
        <Border Grid.Column="0" Background="{DynamicResource RailBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,14,0,18">
                    <Border Width="46" Height="46" CornerRadius="11" BorderThickness="2" HorizontalAlignment="Center"
                            Background="{StaticResource LapisBrush}" BorderBrush="{StaticResource EyeGoldBrush}">
                        <Image Source="{StaticResource EyeImage}" Width="32" Stretch="Uniform" Effect="{StaticResource EyeShadow}" />
                    </Border>
                    <TextBlock Text="U&#x2009;D&#x2009;J&#x2009;A&#x2009;T" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="OverviewItem" GroupName="Pages" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavOverview}" Content="Overview" Checked="OnPageChecked" />
                    <RadioButton x:Name="FansItem" GroupName="Pages" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource NavFan}" Content="Fans" Checked="OnPageChecked" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <Button Click="OnThemeClick" AutomationProperties.Name="Switch theme">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavAction}">
                                <Setter Property="Tag" Value="{StaticResource NavSun}" />
                                <Setter Property="Content" Value="Light" />
                                <Setter Property="ToolTip" Value="Switch to the light theme" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Theme}" Value="Light">
                                        <Setter Property="Tag" Value="{StaticResource NavMoon}" />
                                        <Setter Property="Content" Value="Dark" />
                                        <Setter Property="ToolTip" Value="Switch to the dark theme" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Grid>
                        <RadioButton x:Name="SettingsItem" GroupName="Pages" Style="{StaticResource NavItem}"
                                     Tag="{StaticResource NavGear}" Content="Settings" Checked="OnPageChecked" />
                        <!-- Shown while the settings page has changes that are not saved yet -->
                        <Ellipse x:Name="SettingsDot" Visibility="Collapsed" Width="7" Height="7" Margin="0,9,22,0" IsHitTestVisible="False"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource WarningBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The top bar, the notices, and the selected page -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="4,0,4,14">
                <TextBlock DockPanel.Dock="Right" Text="{Binding InfoText}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Border CornerRadius="12" Padding="10,3" BorderThickness="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.State}" Value="Normal">
                                        <Setter Property="Background" Value="{DynamicResource NormalSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource NormalBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource NormalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status.State}" Value="Warning">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status.State}" Value="Critical">
                                        <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource CriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding Status.PillText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Things to tell the user, on every page -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Notices}" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="4,0,4,8">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismiss" Style="{StaticResource NoticeButton}"
                                        Visibility="{Binding DismissVisibility}" />
                                <Button DockPanel.Dock="Right" Content="{Binding Notice.LinkText}" Click="OnOpenLink" Style="{StaticResource NoticeButton}"
                                        Visibility="{Binding LinkVisibility}" />
                                <TextBlock Text="{Binding Notice.Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- All the pages are here all the time; only the chosen one is visible. A page that left the window could not find its commands. -->
            <Grid x:Name="PageHost" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
