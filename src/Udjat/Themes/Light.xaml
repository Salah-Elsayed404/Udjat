<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The light theme: the same keys as Dark.xaml, with darker versions of the colours so text and lines stay clear on white. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E1E4E8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#656D76" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0891B2" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E5E9EF" />
    <SolidColorBrush x:Key="NormalBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="VramBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="NormalSoftBrush" Color="#DAFBE1" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF8C5" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#FFEBE9" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF6DD" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#E8C766" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EAEEF2" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#EDF0F3" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#170891B2" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#9BD3E0" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E8EBEF" />
</ResourceDictionary>
