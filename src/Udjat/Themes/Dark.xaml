<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The dark theme. Light.xaml has the same keys; switching replaces one dictionary and every window follows. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0E13" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121821" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#1F2A37" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7D8590" />
    <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1F2A37" />
    <SolidColorBrush x:Key="NormalBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E3B341" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#F85149" />
    <SolidColorBrush x:Key="VramBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="NormalSoftBrush" Color="#0F2A1C" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#2B2111" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#2D1315" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#2B2111" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#6E5313" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="#0F141B" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A22D3EE" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#155E6B" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1C2531" />
</ResourceDictionary>
