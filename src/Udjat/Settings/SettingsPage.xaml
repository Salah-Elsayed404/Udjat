<UserControl x:Class="Udjat.Settings.SettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,14">
            <RadioButton x:Name="AlertsTabItem" GroupName="SettingsTabs" Style="{StaticResource SubTab}" Content="Alerts" Checked="OnTabChecked" />
            <RadioButton x:Name="ChannelsTabItem" GroupName="SettingsTabs" Style="{StaticResource SubTab}" Content="Channels" Checked="OnTabChecked" />
            <RadioButton x:Name="ProtectTabItem" GroupName="SettingsTabs" Style="{StaticResource SubTab}" Content="Auto-protect" Checked="OnTabChecked" />
            <RadioButton x:Name="GeneralTabItem" GroupName="SettingsTabs" Style="{StaticResource SubTab}" Content="General" Checked="OnTabChecked" />
        </StackPanel>

        <Grid x:Name="TabHost" Grid.Row="1" />

        <!-- Appears when something changed, or just after saving; a problem replaces its text. -->
        <Border Grid.Row="2" Margin="4,10,4,0" Padding="14,9" CornerRadius="10" BorderThickness="1"
                Visibility="{Binding BarVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource NoticeBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource NoticeBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource NormalSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource NormalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BarIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                    <Button Content="Discard" Style="{StaticResource SecondaryButton}" Click="OnDiscard" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
                </StackPanel>
                <TextBlock Text="{Binding BarText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
