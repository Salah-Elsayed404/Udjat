<UserControl x:Class="Udjat.Settings.ChannelsTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Udjat.Settings"
             xmlns:alerts="clr-namespace:Udjat.Core.Alerts;assembly=Udjat.Core">

    <UserControl.Resources>
        <s:EnumIsConverter x:Key="EnumIs" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The words next to a Test button: how the last try went, in red when it failed. -->
        <Style x:Key="TestText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChannelName" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Windows notification and sound: nothing to set up, only on or off. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Test" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding ToastTest.CanTest}"
                                Command="{x:Static s:SettingsCommands.Test}" CommandParameter="{x:Static alerts:ChannelKind.Toast}" />
                        <TextBlock DataContext="{Binding ToastTest}" Text="{Binding Text}" Style="{StaticResource TestText}" />
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Form.ToastEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Windows notification" Style="{StaticResource ChannelName}" />
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Test" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding SoundTest.CanTest}"
                                Command="{x:Static s:SettingsCommands.Test}" CommandParameter="{x:Static alerts:ChannelKind.Sound}" />
                        <TextBlock DataContext="{Binding SoundTest}" Text="{Binding Text}" Style="{StaticResource TestText}" />
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Form.SoundEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Sound alarm" Style="{StaticResource ChannelName}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Email -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Test" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding EmailTest.CanTest}"
                                Command="{x:Static s:SettingsCommands.Test}" CommandParameter="{x:Static alerts:ChannelKind.Email}" />
                        <TextBlock DataContext="{Binding EmailTest}" Text="{Binding Text}" Style="{StaticResource TestText}" />
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Form.EmailEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Email" Style="{StaticResource ChannelName}" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Mail server" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Form.EmailHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="90" HorizontalAlignment="Left" Text="{Binding Form.EmailPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Connection" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SubTab}" Content="STARTTLS (usually port 587)"
                                             IsChecked="{Binding Form.EmailSecurity, Mode=TwoWay, Converter={StaticResource EnumIs}, ConverterParameter=StartTls}" />
                                <RadioButton Style="{StaticResource SubTab}" Content="SSL (usually port 465)"
                                             IsChecked="{Binding Form.EmailSecurity, Mode=TwoWay, Converter={StaticResource EnumIs}, ConverterParameter=SslOnConnect}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Form.EmailUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SmtpPassword.Status}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                            </DockPanel>
                            <PasswordBox s:PasswordBinder.Password="{Binding SmtpPassword.Typed, Mode=TwoWay}" />
                            <Button Content="Remove the saved password" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Visibility="{Binding SmtpPassword.CanRemove, Converter={StaticResource BoolToVis}}" Command="{x:Static s:SettingsCommands.RemoveSecret}" CommandParameter="Smtp" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="Send from" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Form.EmailFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Text="Send to" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Form.EmailTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Example for Gmail: server smtp.gmail.com, port 587, STARTTLS, and an app password (not your normal password). The connection is always encrypted." />
                </StackPanel>
            </Border>

            <!-- Telegram -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Test" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding TelegramTest.CanTest}"
                                Command="{x:Static s:SettingsCommands.Test}" CommandParameter="{x:Static alerts:ChannelKind.Telegram}" />
                        <TextBlock DataContext="{Binding TelegramTest}" Text="{Binding Text}" Style="{StaticResource TestText}" />
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Form.TelegramEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Telegram" Style="{StaticResource ChannelName}" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TelegramToken.Status}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Bot token" Style="{StaticResource FieldLabel}" />
                            </DockPanel>
                            <PasswordBox s:PasswordBinder.Password="{Binding TelegramToken.Typed, Mode=TwoWay}" />
                            <Button Content="Remove the saved token" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Visibility="{Binding TelegramToken.CanRemove, Converter={StaticResource BoolToVis}}" Command="{x:Static s:SettingsCommands.RemoveSecret}" CommandParameter="Telegram" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chat id" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Form.TelegramChatId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="How to set it up: in Telegram, talk to @BotFather and create a bot to get its token. Send your new bot any message, then find your chat id (a number) with a bot such as @userinfobot." />
                </StackPanel>
            </Border>

            <!-- Which channels each level uses -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Where alerts go" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                               Text="A channel only works when its switch above is on and, for email and Telegram, it is set up." />

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Warning goes to" Width="130" VerticalAlignment="Center" />
                        <CheckBox Content="Windows notification" IsChecked="{Binding Form.WarningToast, Mode=TwoWay}" />
                        <CheckBox Content="Sound" IsChecked="{Binding Form.WarningSound, Mode=TwoWay}" />
                        <CheckBox Content="Email" IsChecked="{Binding Form.WarningEmail, Mode=TwoWay}" />
                        <CheckBox Content="Telegram" IsChecked="{Binding Form.WarningTelegram, Mode=TwoWay}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Critical goes to" Width="130" VerticalAlignment="Center" />
                        <CheckBox Content="Windows notification" IsChecked="{Binding Form.CriticalToast, Mode=TwoWay}" />
                        <CheckBox Content="Sound" IsChecked="{Binding Form.CriticalSound, Mode=TwoWay}" />
                        <CheckBox Content="Email" IsChecked="{Binding Form.CriticalEmail, Mode=TwoWay}" />
                        <CheckBox Content="Telegram" IsChecked="{Binding Form.CriticalTelegram, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
