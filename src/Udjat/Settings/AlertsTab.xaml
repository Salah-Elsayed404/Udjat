<UserControl x:Class="Udjat.Settings.AlertsTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Udjat.Settings">

    <!-- When to alert: the limits of each sensor, and how often the same alert may repeat. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="When to alert" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,14"
                           Text="Udjat tells you when a sensor passes its Warning limit, and again at its Critical limit. Choose where each alert goes in Channels." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sensor" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Column="1" Text="Alert" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Column="2" Text="Warning" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Column="3" Text="Critical" Style="{StaticResource FieldLabel}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Form.Thresholds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" Padding="0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="· full is normal for local AI" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="GpuVram">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Left"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding Enabled}">
                                        <TextBox Width="68" Text="{Binding Warning, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" IsEnabled="{Binding Enabled}">
                                        <TextBox Width="68" Text="{Binding Critical, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Content="Reset to defaults" Style="{StaticResource LinkButton}" FontSize="12"
                            VerticalAlignment="Center" Command="{x:Static s:SettingsCommands.ResetAlerts}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Repeat the same alert after" VerticalAlignment="Center" />
                        <TextBox Width="64" Margin="10,0" Text="{Binding Form.CooldownMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="minutes" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
